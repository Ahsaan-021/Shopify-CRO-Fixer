# Public site URL used for canonical links, the sitemap, and robots.txt.
# For local development this default is fine.
# Set this to your real HTTPS domain before deploying (for example
# https://your-project.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only Google PageSpeed Insights API key.
# Leave blank to use Google's lower anonymous quota.
# Never prefix this with NEXT_PUBLIC_ and never commit a real key.
PAGESPEED_API_KEY=
