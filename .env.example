# Public site URL used for canonical links, the sitemap, and robots.txt.
# For local development http://localhost:3000 is fine.
# Set this to your real HTTPS domain before deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Google PageSpeed Insights API key. Required for the speed panel.
# Leave blank locally until you add a key. Never prefix this with NEXT_PUBLIC_,
# never log it, and never commit a real key.
PAGESPEED_API_KEY=

# Optional server-only switch for the rendered mobile audit.
# Leave blank or set to true to enable it. Set to false to disable the browser
# and keep only the static HTML and product JSON findings.
RENDERED_AUDIT_ENABLED=

# Optional local Chrome or Edge path. Leave blank to auto-detect an installed
# browser on this machine. On Vercel the bundled serverless Chromium is used.
CHROME_EXECUTABLE_PATH=
